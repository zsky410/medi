{
  "name": "medi",
  "private": true,
  "version": "0.1.0",
  "description": "Mê Đi (medi) - Travel planning SaaS",
  "scripts": {
    "dev": "node scripts/wait-for-deps.mjs && node scripts/free-dev-ports.mjs && node scripts/dev.mjs",
    "dev:all": "turbo run dev",
    "dev:stop": "node scripts/free-dev-ports.mjs",
    "dev:setup": "pnpm dev",
    "mobile": "pnpm --dir apps/mobile dev",
    "mobile:clear": "pnpm --dir apps/mobile dev -- --clear",
    "mobile:stop": "node scripts/free-mobile-ports.mjs",
    "mobile:fresh": "node scripts/free-mobile-ports.mjs && pnpm --dir apps/mobile dev -- --clear",
    "mobile:tunnel": "node scripts/free-mobile-ports.mjs && pnpm --dir apps/mobile exec expo start --tunnel --clear",
    "mobile:usb": "node scripts/start-mobile-usb.mjs",
    "mobile:android": "pnpm --dir apps/mobile android",
    "mobile:ios": "pnpm --dir apps/mobile ios",
    "mobile:lint": "pnpm --dir apps/mobile lint",
    "mobile:test": "pnpm --dir apps/mobile test",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @medi/api db:migrate",
    "db:seed": "pnpm --filter @medi/api db:seed",
    "db:seed:demo": "pnpm --filter @medi/api db:seed:demo",
    "scrape:goong": "node scripts/scrape-goong-help.mjs"
  },
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "turbo": "^2.10.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0"
    }
  }
}
